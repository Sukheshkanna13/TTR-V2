[Unit]
Description=TTR-V2 gunicorn (Django web)
After=network.target mysql.service
Wants=mysql.service

[Service]
User=ttr
Group=www-data
WorkingDirectory=/srv/ttr/app
EnvironmentFile=/etc/ttr/ttr.env
RuntimeDirectory=ttr
RuntimeDirectoryMode=0755
ExecStart=/srv/ttr/venv/bin/gunicorn hotel_booking.wsgi \
    --workers 3 --timeout 60 \
    --bind unix:/run/ttr/gunicorn.sock --umask 007 \
    --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/ttr

[Install]
WantedBy=multi-user.target
