# /etc/ttr/ttr.env  — chmod 640, owner root:ttr. Never commit the real file.
# Loaded by both systemd units via EnvironmentFile=.

DJANGO_SETTINGS_MODULE=hotel_booking.settings.prod
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=False

# Your domain(s), comma separated, no scheme
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

DATABASE_URL=mysql://ttr_user:strong-password@127.0.0.1:3306/ttr_v2

# nginx terminates TLS and overwrites X-Forwarded-For (see deploy/nginx-ttr.conf)
SECURE_SSL_REDIRECT=True
TRUST_PROXY_HEADERS=True

# Real email is REQUIRED: the default backend prints OTPs to the logs
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=

HOLD_DURATION_MINUTES=10
DJANGO_LOG_LEVEL=INFO

# Optional booking bounds (defaults shown)
#MAX_STAY_NIGHTS=90
#MAX_ADVANCE_BOOKING_DAYS=730

# Public origin used for absolute URLs in emails (logo). No trailing slash.
SITE_URL=https://example.com
